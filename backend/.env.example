# Entorno
NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL (usa DATABASE_URL o variables individuales)
# Para Neon/Supabase/Render: DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=rental_management
DB_USER=postgres
DB_PASS=tu_password_postgres

# JWT
JWT_SECRET=tu_secreto_jwt_super_seguro_aqui
JWT_EXPIRES_IN=7d

# Email - Opción 1: SendGrid API (recomendado para Render/producción, evita timeout SMTP)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=tu_email_verificado@ejemplo.com

# Email - Opción 2: SMTP (Nodemailer, para desarrollo local)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_password_de_aplicacion

# Frontend URL (para CORS y enlaces en emails)
FRONTEND_URL=http://localhost:4200
